# Copy to monitor.env on the VPS (chmod 600). No private keys belong in this file.

# Address to watch (read-only — the trading wallet or vault address)
WALLET_ADDRESS=0x...

# Telegram: create a bot with @BotFather, send it any message, then get your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert when price is within this % of the liquidation price
LIQ_WARN_PCT=10
# Repeat an unresolved alert every N hours
REMIND_HOURS=6
# Hour (UTC) of the daily summary; -1 turns it off
DAILY_UTC_HOUR=13

# Optional: alert when the trader stops checking in (see README)
# HEARTBEAT_FILE=/home/imd/trader-monitor/heartbeat
# HEARTBEAT_MAX_MIN=90
